# Frontend development configuration
# Copy the relevant values to frontend/.env.local. Do not commit real IDs or secrets.
VITE_API_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/dev
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=your-client-id
VITE_COGNITO_DOMAIN=your-cognito-domain.auth.us-east-1.amazoncognito.com
VITE_GOOGLE_ENABLED=false
VITE_DISCORD_ENABLED=false
VITE_APP_URL=http://localhost:5173

# Optional local Lambda smoke-test values
# Deployed Lambda values are supplied by backend/template.yaml parameters and resources.
AWS_REGION=us-east-1
ENVIRONMENT=dev
REMINDER_FROM_EMAIL=noreply@munera.com
APP_URL=http://localhost:5173

# Deployment prerequisites are not stored in .env files:
# - Pass the environment-specific LabRoleArn to SAM/CloudFormation.
# - Use a verified SES source identity for CognitoFromEmail/reminder delivery.
# - Keep OAuth client secrets and encryption keys in protected deployment parameters.

# Optional Smart AI Lambda configuration for local invocation only.
# Never prefix these with VITE_ or commit real keys. Production values are
# supplied as the required NoEcho GeminiApiKey parameter; numbered values are optional rate-limit fallbacks.
GEMINI_API_KEY=replace-with-primary-key
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=replace-with-second-fallback-key
GEMINI_API_KEY_3=replace-with-third-fallback-key
GEMINI_MODEL=gemini-3.1-pro-preview
