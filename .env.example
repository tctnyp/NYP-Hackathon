# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=your-account-id

# Aurora Database
DB_HOST=your-aurora-cluster.cluster-xxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=academic_task_manager
DB_USER=admin
DB_PASSWORD=your-secure-password

# AWS Cognito
COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-client-id
COGNITO_REGION=ap-southeast-1

# SNS for notifications
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:xxxx:academic-reminders

# API Gateway
API_GATEWAY_URL=https://xxxxx.execute-api.ap-southeast-1.amazonaws.com/prod

# Frontend (for Amplify)
REACT_APP_API_URL=https://xxxxx.execute-api.ap-southeast-1.amazonaws.com/prod
REACT_APP_COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
REACT_APP_COGNITO_CLIENT_ID=your-client-id
REACT_APP_COGNITO_REGION=ap-southeast-1
